# Template — do NOT put real secrets here. scripts/setup.sh copies this to .env with generated
# passwords. .env itself is ignored by Git.
COMPOSE_PROJECT_NAME=rms
COMPOSE_FILE=__COMPOSE_FILE__

# VERIFY these tags (Odoo 19 image; PostgreSQL version supported by Odoo 19). Pin what you validated.
ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16

POSTGRES_USER=odoo
POSTGRES_PASSWORD=__PG_PASSWORD__

# Database used by the app, backups and (in prod) the Odoo db filter.
DB_NAME=rms

# Prod only: public hostname served by Caddy (or "localhost" for a local test).
DOMAIN=__DOMAIN__

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
