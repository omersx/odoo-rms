<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Product form: camera Scan button on the Barcode field (D-022) -->
    <record id="product_template_form_barcode_scan" model="ir.ui.view">
        <field name="name">product.template.form.barcode.scan</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="attributes">
                <attribute name="widget">barcode_scan</attribute>
            </field>
        </field>
    </record>

</odoo>
