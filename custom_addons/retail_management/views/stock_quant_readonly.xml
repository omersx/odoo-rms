<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- On-hand quantities, read-only, for the shop (owner's request, D-044).
         The cashier already has read access to stock.quant from stock's own ACL
         (access_stock_quant_all: base.group_user 1,0,0,0); what he lacked was the menu and the
         action, which core gates on stock.group_stock_user. His write access stays denied. -->
    <record id="view_retail_quant_list" model="ir.ui.view">
        <field name="name">retail_management.stock.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" sample="1">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"/>
                <field name="reserved_quantity"/>
                <field name="available_quantity"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
            </list>
        </field>
    </record>

    <record id="action_retail_quants" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_retail_quant_list"/>
        <field name="search_view_id" ref="stock.quant_search_view"/>
        <field name="domain">[('location_id.usage', 'in', ['internal', 'transit'])]</field>
    </record>
</odoo>
