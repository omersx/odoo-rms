<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retail workspace: links to native Odoo actions, owns no logic of its own. -->
    <menuitem id="menu_retail_root"
              name="Retail Management"
              web_icon="retail_management,static/description/icon.png"
              sequence="45"/>

    <menuitem id="menu_retail_pos"
              name="Point of Sale"
              parent="menu_retail_root"
              action="point_of_sale.action_pos_config_kanban"
              groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager"
              sequence="10"/>

    <menuitem id="menu_retail_products"
              name="Products"
              parent="menu_retail_root"
              action="stock.product_template_action_product"
              sequence="20"/>

    <menuitem id="menu_retail_inventory"
              name="Inventory"
              parent="menu_retail_root"
              action="stock.stock_picking_type_action"
              groups="stock.group_stock_user"
              sequence="30"/>

    <menuitem id="menu_retail_invoicing"
              name="Invoicing"
              parent="menu_retail_root"
              action="account.action_move_out_invoice"
              groups="account.group_account_invoice"
              sequence="40"/>

    <menuitem id="menu_retail_customers"
              name="Customers"
              parent="menu_retail_root"
              action="account.res_partner_action_customer"
              groups="base.group_partner_manager"
              sequence="50"/>

    <menuitem id="menu_retail_settings"
              name="Settings"
              parent="menu_retail_root"
              action="point_of_sale.action_pos_configuration"
              groups="point_of_sale.group_pos_manager"
              sequence="90"/>
</odoo>
