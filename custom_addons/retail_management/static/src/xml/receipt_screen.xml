<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Owner's request: a clearly labelled button for getting the receipt as a PDF file.
         Browsers do not allow saving/printing without the user's confirmation, so this opens the
         same print dialog as "Print Full Receipt" — the cashier picks "Save as PDF" as destination.
         Reuses the core handler (doFullPrint) so the print counter and printer fallback stay native.
         Delete this file from the manifest to get the stock receipt screen back. -->
    <t t-name="retail_management.ReceiptScreenSavePdf"
       t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print')][1]" position="after">
            <button class="button save-pdf btn btn-lg btn-secondary w-100 py-3"
                    title="Choose 'Save as PDF' as the destination"
                    t-on-click="() => doFullPrint.call()">
                <i t-attf-class="fa {{doFullPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-file-pdf-o'}} me-1" />
                Save as PDF
            </button>
        </xpath>
    </t>
</templates>
