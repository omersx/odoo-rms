<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Odoo 19 shows the app switcher as a plain text dropdown. Inheriting the template restores
         the icon grid the owner expects, without touching Odoo core. Remove this file from the
         manifest to get the stock dropdown back. -->
    <t t-name="retail_management.AppsMenuGrid"
       t-inherit="web.NavBar.AppsMenu"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='content']" position="replace">
            <t t-set-slot="content">
                <div class="o_retail_app_grid">
                    <a t-foreach="apps" t-as="app" t-key="app.id"
                       class="o_retail_app_grid_item"
                       t-att-href="getMenuItemHref(app)"
                       t-att-data-menu-xmlid="app.xmlid"
                       t-att-data-section="app.id"
                       t-on-click="() => this.onNavBarDropdownItemSelection(app)">
                        <img t-if="app.webIconData"
                             class="o_retail_app_grid_icon"
                             t-att-src="app.webIconData"
                             t-att-alt="app.name"/>
                        <span class="o_retail_app_grid_label" t-esc="app.name"/>
                    </a>
                </div>
            </t>
        </xpath>
    </t>
</templates>
